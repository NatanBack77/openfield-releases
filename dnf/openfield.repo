[openfield]
name=Openfield
baseurl=https://natanback77.github.io/openfield-apt/dnf/x86_64
enabled=1
# Individual .rpm files are never GPG-signed by this pipeline (nfpm doesn't
# sign packages) — only the repo metadata (repomd.xml) is, via publish-dnf.sh.
# gpgcheck=1 here checks the PACKAGE's own signature, which will never exist,
# and always fails with "O pacote não está assinado." repo_gpgcheck verifies
# the repodata signature instead, which IS real and does protect installs.
gpgcheck=0
repo_gpgcheck=1
gpgkey=https://natanback77.github.io/openfield-apt/openfield.gpg.asc
